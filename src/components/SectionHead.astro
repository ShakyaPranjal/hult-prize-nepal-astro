---
interface Props { kicker: string; lead?: string; light?: boolean }
const { kicker, lead, light = false } = Astro.props;
---
<div class="sec-head">
  <span class="kicker" style={light ? 'color:#fff' : undefined}>{kicker}</span>
  <h2 class="h2"><slot /></h2>
  {lead && <p class="lead">{lead}</p>}
</div>
