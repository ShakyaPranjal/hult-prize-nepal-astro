---
import { season } from '../data/site';
---
<section class="sec enter" id="enter">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker" style="color:#fff">Share this with your students</span>
      <h2 class="h2">Got an idea that could <em>change the world?</em></h2>
      <p class="lead" style="color:rgba(255,255,255,.88)">Enter the EF Hult Prize 2026–27. Build a startup that tackles a real problem, pitch it, and you could represent Nepal where one team wins US$1,000,000.</p>
    </div>
    <div class="enter-grid">
      <div class="ecard reveal"><h3>Who can enter</h3><ul><li>Teams of 2 to 4 students</li><li>Enrolled in a degree program at a college or university</li><li>All members 18 or over by 28 February 2027</li><li>Members may study at different colleges, but the team represents one</li></ul></div>
      <div class="ecard reveal d1"><h3>Two ways in</h3><ul><li><b>OnCampus Program:</b> join your college's program, attend workshops and win the Grand Finale</li><li><b>Open Application:</b> no program at your college? Apply at hultprize.org and pass the online reviews</li></ul><a class="btn btn-dark" href={season.register} target="_blank" rel="noopener" style="justify-self:start">Apply at hultprize.org ↗</a></div>
      <div class="ecard reveal d2"><h3>Key dates</h3><div class="dates"><div><b>Sep 2026 – Feb 2027</b><span>OnCampus Programs and Open Application</span></div><div><b>Before Nationals</b><span>Workshops on business models and pitching</span></div><div><b>Last week of Apr 2027</b><span>Hult Prize Nepal National Competition</span></div><div><b>Jun – Sep 2027</b><span>Digital Incubator, Global Accelerator (UK), Global Finals</span></div></div></div>
    </div>
  </div>
</section>

